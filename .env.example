# EduRacha Backend — variables de entorno (sin secretos)
# Copiar a .env local o configurar en el host (Render/Sevalla). Nunca commitear valores reales.

PORT=8080
FIREBASE_DATABASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_BASE64=JSON_SERVICE_ACCOUNT_EN_BASE64
JWT_SECRET=cambia-esta-clave-larga-en-produccion

# IA desacoplada: groq | openai | anthropic | openai-compatible | ollama | mock
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Opcional: si se omite, cada adaptador usa su endpoint oficial
# AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=60

# Legacy (compatibilidad, preferir AI_*):
# OPENAI_API_KEY=
# GROQ_API_KEY=
